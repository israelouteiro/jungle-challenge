{
  "uid": "wagering-overview",
  "title": "Jungle Gaming · Wagering Processor",
  "description": "Demonstração local: correção financeira, concorrência e entrega de eventos. Métricas reais das réplicas Docker.",
  "tags": ["jungle", "wagering", "demo"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "editable": false,
  "refresh": "1s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "links": [
    {
      "title": "Executar testes",
      "type": "link",
      "url": "http://localhost:3002",
      "targetBlank": true
    },
    {
      "title": "API / contratos",
      "type": "link",
      "url": "http://localhost:3000/docs/",
      "targetBlank": true
    },
    {
      "title": "Traces · Jaeger",
      "type": "link",
      "url": "http://localhost:16686",
      "targetBlank": true
