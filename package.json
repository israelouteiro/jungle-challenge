{
  "name": "jungle-tech-challenge",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && bun run docs:build",
    "start": "bun dist/main.js",
    "start:dev": "bun run docs:build && tsc-watch --onSuccess \"bun dist/main.js\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "bun test test/unit",
    "test:integration": "bun run build && bun test/support/run-integration.ts",
    "migration:up": "bun src/infrastructure/database/migrate.ts",
    "migration:down": "bun src/infrastructure/database/migrate.ts down",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "test:all": "bun run format:check && bun run typecheck && bun run test && bun run test:integration",
    "format": "prettier --write src test docs postman infra/observability scripts/presentation *.json *.md compose.yaml",
    "format:check": "prettier --check src test docs postman infra/observability scripts/presentation *.json *.md compose.yaml",
    "test:load": "bun run build && bun test/load/run.ts",
    "docs:build": "bun --bun node_modules/apidoc/bin/apidoc -c apidoc.json -i src/http -o dist/apidoc --write-json --warn-error",
    "docs:check": "bun --bun node_modules/apidoc/bin/apidoc -c apidoc.json -i src/http --dry-run --warn-error",
    "load:install": "bun test/load/install-oha.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1164.0",
    "@mikro-orm/core": "^7.2.8",
    "@mikro-orm/migrations": "^7.2.8",
    "@mikro-orm/postgresql": "^7.2.8",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.0",
    "@opentelemetry/core": "^3.1.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
    "@opentelemetry/resources": "^3.1.0",
    "@opentelemetry/sdk-trace": "^3.1.0",
    "decimal.js": "^10.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "apidoc": "^1.2.0",
    "prettier": "^3.9.10",
    "tsc-watch": "^7.2.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.4"
}
